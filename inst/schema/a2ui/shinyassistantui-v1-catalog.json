{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shinyassistantui:a2ui:catalog:v1",
  "catalogId": "urn:shinyassistantui:a2ui:catalog:v1",
  "title": "shinyAssistantUI A2UI Catalog v1",
  "description": "Strict A2UI v0.9/v0.9.1 subset. Video, audio, tabs, modal, checks, sendDataModel, and local functions other than openUrl are unsupported.",
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:@/-]*$","maxLength":128},
    "binding": {"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":1024}},"required":["path"],"additionalProperties":false},
    "dynamicString": {"oneOf":[{"type":"string","maxLength":16384},{"$ref":"#/$defs/binding"}]},
    "dynamicNumber": {"oneOf":[{"type":"number"},{"$ref":"#/$defs/binding"}]},
    "dynamicBoolean": {"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/binding"}]},
    "dynamicStringList": {"oneOf":[{"type":"array","maxItems":100,"items":{"type":"string","maxLength":16384}},{"$ref":"#/$defs/binding"}]},
    "iconName": {"oneOf":[{"enum":["sun","moon","cloud","rain","snow","wind","play","pause","check","x","star","heart","arrow-right","arrow-up-right","chevron-right","calendar","clock","map-pin","plane","truck","credit-card","user","search","bell"]},{"$ref":"#/$defs/binding"}]},
    "child": {"$ref":"#/$defs/id"},
    "children": {"oneOf":[{"type":"array","maxItems":500,"items":{"$ref":"#/$defs/child"}},{"type":"object","properties":{"componentId":{"$ref":"#/$defs/child"},"path":{"type":"string","minLength":1,"maxLength":1024}},"required":["componentId","path"],"additionalProperties":false}]},
    "options": {"type":"array","maxItems":100,"items":{"type":"object","properties":{"label":{"$ref":"#/$defs/dynamicString"},"value":{"type":"string","maxLength":16384}},"required":["label","value"],"additionalProperties":false}},
    "action": {"type":"object","properties":{"event":{"type":"object","properties":{"name":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},"context":{"type":"object"},"userMessage":{"$ref":"#/$defs/dynamicString"}},"required":["name"],"additionalProperties":false},"functionCall":{"$ref":"#/functions/openUrl"}},"oneOf":[{"required":["event"]},{"required":["functionCall"]}],"additionalProperties":false}
  },
  "components": {
    "Text": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"Text"},"text":{"$ref":"#/$defs/dynamicString"},"value":{"$ref":"#/$defs/dynamicString"},"variant":{"enum":["h1","h2","h3","h4","h5","h6","caption","body"]}},"required":["id","component"],"anyOf":[{"required":["text"]},{"required":["value"]}],"additionalProperties":false},
    "Image": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"Image"},"src":{"$ref":"#/$defs/dynamicString"},"url":{"$ref":"#/$defs/dynamicString"},"alt":{"$ref":"#/$defs/dynamicString"},"altText":{"$ref":"#/$defs/dynamicString"},"description":{"$ref":"#/$defs/dynamicString"},"size":{"oneOf":[{"type":"number","minimum":16,"maximum":1024},{"enum":["sm","md","lg"]}]},"round":{"type":"boolean"}},"required":["id","component"],"allOf":[{"anyOf":[{"required":["src"]},{"required":["url"]}]},{"anyOf":[{"required":["alt"]},{"required":["altText"]},{"required":["description"]}]}],"additionalProperties":false},
    "Icon": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"Icon"},"name":{"$ref":"#/$defs/iconName"},"size":{"enum":["sm","md","lg"]}},"required":["id","component","name"],"additionalProperties":false},
    "Row": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"Row"},"children":{"$ref":"#/$defs/children"},"gap":{"type":"number","minimum":0,"maximum":8},"align":{"enum":["start","center","end"]},"alignment":{"enum":["start","center","end"]},"justify":{"enum":["start","center","end","between"]},"distribution":{"enum":["start","center","end","between"]}},"required":["id","component"],"additionalProperties":false},
    "Column": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"Column"},"children":{"$ref":"#/$defs/children"},"gap":{"type":"number","minimum":0,"maximum":8},"align":{"enum":["start","center","end"]},"alignment":{"enum":["start","center","end"]}},"required":["id","component"],"additionalProperties":false},
    "List": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"List"},"children":{"$ref":"#/$defs/children"},"direction":{"enum":["vertical","horizontal"]},"align":{"enum":["start","center","end"]}},"required":["id","component"],"additionalProperties":false},
    "Card": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"Card"},"child":{"$ref":"#/$defs/child"},"children":{"$ref":"#/$defs/children"},"title":{"$ref":"#/$defs/dynamicString"},"padding":{"type":"number","minimum":0,"maximum":8}},"required":["id","component"],"additionalProperties":false},
    "Divider": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"Divider"},"flush":{"type":"boolean"}},"required":["id","component"],"additionalProperties":false},
    "Button": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"Button"},"child":{"$ref":"#/$defs/child"},"text":{"$ref":"#/$defs/dynamicString"},"label":{"$ref":"#/$defs/dynamicString"},"variant":{"enum":["primary","borderless"]},"action":{"$ref":"#/$defs/action"}},"required":["id","component"],"anyOf":[{"required":["child"]},{"required":["text"]},{"required":["label"]}],"additionalProperties":false},
    "TextField": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"TextField"},"label":{"$ref":"#/$defs/dynamicString"},"placeholder":{"$ref":"#/$defs/dynamicString"},"value":{"$ref":"#/$defs/dynamicString"},"text":{"$ref":"#/$defs/dynamicString"},"variant":{"enum":["shortText","longText","obscured","number"]},"multiline":{"type":"boolean"},"textFieldType":{"type":"string"}},"required":["id","component"],"additionalProperties":false},
    "CheckBox": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"CheckBox"},"label":{"$ref":"#/$defs/dynamicString"},"value":{"$ref":"#/$defs/dynamicBoolean"},"defaultChecked":{"type":"boolean"}},"required":["id","component","label"],"additionalProperties":false},
    "ChoicePicker": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"ChoicePicker"},"label":{"$ref":"#/$defs/dynamicString"},"options":{"$ref":"#/$defs/options"},"value":{"$ref":"#/$defs/dynamicStringList"},"variant":{"enum":["mutuallyExclusive","multipleSelection","chips"]}},"required":["id","component","options"],"additionalProperties":false},
    "DateTimeInput": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"DateTimeInput"},"label":{"$ref":"#/$defs/dynamicString"},"value":{"$ref":"#/$defs/dynamicString"},"min":{"$ref":"#/$defs/dynamicString"},"max":{"$ref":"#/$defs/dynamicString"},"enableDate":{"type":"boolean"},"enableTime":{"type":"boolean"}},"required":["id","component"],"additionalProperties":false},
    "Slider": {"type":"object","properties":{"id":{"$ref":"#/$defs/id"},"component":{"const":"Slider"},"label":{"$ref":"#/$defs/dynamicString"},"value":{"$ref":"#/$defs/dynamicNumber"},"min":{"type":"number"},"max":{"type":"number"},"steps":{"type":"integer","minimum":1}},"required":["id","component","min","max"],"additionalProperties":false}
  },
  "functions": {
    "openUrl": {
      "type": "object",
      "properties": {
        "call": {"const":"openUrl"},
        "args": {"type":"object","properties":{"url":{"type":"string","format":"uri","maxLength":16384}},"required":["url"],"additionalProperties":false},
        "returnType": {"const":"void"}
      },
      "required": ["call","args"],
      "additionalProperties": false
    }
  }
}
